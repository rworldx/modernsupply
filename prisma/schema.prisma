// Modern Supply — database schema.
//
// Postgres in every environment, including local development. The app runs on
// Vercel, whose filesystem is read-only and ephemeral, so a SQLite file cannot
// survive there: writes vanish between requests and the file is absent from a
// fresh deploy. One provider everywhere also keeps a single migration history,
// so what passes locally is what runs in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Live inventory row for each catalog product. Seeded from src/data/products.ts.
// The static catalog stays the source of truth for names/units; this table adds
// the mutable stock + availability that the admin controls and customers see.
model Product {
  id                String      @id // matches the static catalog id, e.g. "fill-biscuit-spread"
  brandId           String
  categoryId        String
  nameEn            String
  nameAr            String
  unitEn            String
  unitAr            String
  priceOmr          Float? // base price in OMR; null = no price yet (storefront shows none)
  imageUrl          String? // product photo URL; null = fall back to the category glyph
  stock             Int         @default(0)
  lowStockThreshold Int         @default(10)
  active            Boolean     @default(true) // false = delisted / discontinued (hidden from customers)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]

  @@index([brandId])
  @@index([categoryId])
}

// An admin-run price reduction. Scope is one of brand / category / product, so a
// single row can discount a whole brand ("20% off all Cremino") or one SKU.
// The lowest-scoped active discount wins for a given product (see lib/pricing).
model Discount {
  id         String   @id @default(cuid())
  scope      String // "brand" | "category" | "product" | "all"
  targetId   String // brandId / categoryId / productId; "" when scope = "all"
  percentOff Int // 1-90
  active     Boolean  @default(true)
  // Optional announcement shown in the storefront popup. When titleEn is set and
  // the discount is active, the popup advertises this offer.
  titleEn    String?
  titleAr    String?
  bodyEn     String?
  bodyAr     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scope, targetId])
  @@index([active])
}

// A customer order. No customer accounts — tracked by orderNumber + phone.
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // human-friendly, e.g. "MS-2026-00042"
  firstName       String
  lastName        String
  phone           String // Oman local number, 8 digits (no +968)
  governorateEn   String
  governorateAr   String
  wilayatEn       String
  wilayatAr       String
  branchId        String // fulfilling branch (from src/data/brand.ts)
  status          String      @default("pending") // pending|confirmed|preparing|out_for_delivery|delivered|cancelled
  deliveryCompany String?
  deliveryFee     Float? // OMR — the delivery fee actually charged (from the governorate zone at checkout; admin may adjust)
  trackingNote    String? // free text shown to customer (e.g. "Driver: Ahmed, ETA 5pm")
  adminNotes      String? // internal, not shown to customer

  // Payment. Money fields are computed server-side at checkout from live prices +
  // discounts + the governorate delivery fee, never trusted from the client.
  paymentMethod   String      @default("cod") // "cod" | "card" | "applepay"
  paymentStatus   String      @default("unpaid") // "unpaid" | "paid" | "failed" | "refunded"
  subtotalOmr     Float       @default(0) // sum of item line totals after discount
  totalOmr        Float       @default(0) // subtotal + deliveryFee
  paymentRef      String? // gateway reference / session id, once a gateway is wired in

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([phone])
  @@index([status])
  @@index([paymentStatus])
}

// Delivery fee per Oman governorate, set by the admin. Absent/inactive = the
// governorate has no online delivery price yet (checkout blocks card/Apple Pay
// for it and falls back to "confirmed by branch"). Keyed by the English
// governorate name from src/data/wilayats.ts.
model DeliveryZone {
  id            String   @id @default(cuid())
  governorateEn String   @unique
  governorateAr String
  feeOmr        Float // OMR, >= 0 (0 = free delivery for this governorate)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Snapshot of a product at order time: names, units, AND the unit price charged
// (after discount) are frozen so the order total stays stable even as catalogue
// prices or discounts change later.
model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  nameEn       String
  nameAr       String
  unitEn       String
  unitAr       String
  quantity     Int
  unitPriceOmr Float   @default(0) // charged unit price after discount, frozen
  lineTotalOmr Float   @default(0) // unitPriceOmr * quantity

  @@index([orderId])
}

// Immutable audit log of stock changes (restocks, sales, manual edits).
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  delta     Int // +restock, -sale/adjust
  reason    String // "restock" | "order" | "manual" | "correction"
  note      String?
  createdAt DateTime @default(now())

  @@index([productId])
}
